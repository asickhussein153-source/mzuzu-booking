    <div>
        <h2>Mzuzu University</h2>
        <p>Room Booking Management System</p>
    </div>

</header>

    <header>
        <nav class="navbar">

            <h2>MZUNI ROOM BOOKING</h2>

            <div class="nav-links">
                <a href="Home.html">Home</a>
                <a href="rooms.html">Rooms</a>
