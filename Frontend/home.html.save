        </nav>
    </header>
  
    <section class="university-image">

    <img src="images/mzuni.jpg"
         alt="Mzuzu University Campus">

</section>

<div class="welcome-text">

    <h2>Welcome to Mzuzu University</h2>

    <p>
        Discover our university facilities and
        conveniently request rooms for meetings,
        seminars, workshops and other academic
        activities.
    </p>

</div>



    <section class="hero">

        <h1>Book University Rooms Online</h1>

        <p>
            Request university rooms for meetings,
            seminars, workshops and other events
            without physically visiting the Porter's Lodge.
        </p>

        <a href="rooms.html" class="btn">
            Explore Available Rooms
        </a>

    </section>

    <section class="about">

        <h2>About Our System</h2>

