
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Room Booking Request</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <header class="university-header">
        <img src="images/Mzuni-logo.jpg"
             class="university-logo"
             alt="Mzuzu University Logo">

        <div>
            <h2>Mzuzu University</h2>
            <p>Room Booking Management System</p>
        </div>
    </header>

    <nav class="navbar">
        <div class="nav-links">
            <a href="Home.html">Home</a>
            <a href="Rooms.html">Rooms</a>
            <a href="booking.html">Book Room</a>
            <a href="login.html">Login</a>
        </div>
    </nav>

    <section class="booking-container">

        <h2>Room Booking Request Form</h2>

        <p>
            Fill in the information below to request
            a university room for your event.
        </p>

             <form id="bookingForm" onsubmit="submitBooking(event)">

            <h3>1. Student Personal Details</h3>

            <label>Full Name</label>
            <input type="text" name="fullName"
                   placeholder="Enter your full name"
                   required>

            <label>Registration Number</label>
            <input type="text" name="registrationNumber"
                   placeholder="Enter registration number"
                   required>

            <label>Email Address</label>
            <input type="email" name="email"
                   placeholder="Enter email address"
                   required>

            <label>Phone Number</label>
            <input type="tel" name="phone"
                   placeholder="Enter phone number"
                   required>


            <h3>2. Event Information</h3>

            <label>Event Name</label>
            <input type="text" name="eventName"
                   placeholder="Enter event name"
                   required>

            <label>Type of Event</label>
            <select name="eventType" required>
                <option value="">Select event type</option>
                <option>Meeting</option>
                <option>Seminar</option>
                <option>Workshop</option>
                <option>Conference</option>
                <option>Academic Activity</option>
                <option>Other</option>
            </select>

            <label>Purpose / Reason for the Event</label>
            <textarea name="purpose"
                      rows="5"
                      placeholder="Explain why you need this room..."
                      required></textarea>

            <label>Expected Number of Participants</label>
            <input type="number" name="participants"
                   min="1"
                   placeholder="Enter number of participants"
                   required>


            <h3>3. Room Booking Details</h3>

            <label>Select Room</label>
            <select name="room" required>
                <option value="">Choose a room</option>
                <option>Room T - Vigwagwa</option>
                <option>Auditorium 1 - Essup Building</option>
                <option>Auditorium 2 - Essup Building</option>
                <option>English Lecture Room - Essup Building</option>
                <option>Geography Lecture Room - Essup Building</option>
            </select>

            <label>Booking Date</label>
            <input type="date" name="bookingDate"
                   required>

            <label>Starting Time</label>
            <input type="time" name="startTime"
                   required>

            <label>Ending Time</label>
            <input type="time" name="endTime"
                   required>


                <button type="submit">
                     Submit Booking Request
                      </button>


        </form>

    </section>

    <footer>
        <p>
            &copy; 2026 Mzuzu University Room Booking System
        </p>
    </footer>

<script>

async function submitBooking(e) {

    e.preventDefault();

    alert("Submitting your booking...");

    const token = localStorage.getItem('token');

    if (!token) {
        alert("Please login first!");
        window.location.href = "login.html";
        return;
    }

    const fd = new FormData(e.target);
    const data = Object.fromEntries(fd.entries());

    try {


          const res = await fetch('http://localhost:3000/api/bookings', {
            method: 'POST',

            headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + token
            },

            body: JSON.stringify(data)

        });

        const out = await res.json();

        if (res.ok) {
            alert("Booking submitted successfully!");
            e.target.reset();
        } else {
            alert(out.message || "Booking failed!");
        }

    } catch (err) {

        console.error(err);
        alert("Cannot connect to the server!");

    }
}

</script>
</body>
</html>
