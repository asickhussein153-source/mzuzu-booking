* { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI', Arial, sans-serif; }
body { background:#f2f4f3; color:#222; line-height:1.6; }
header { background:#0b4d2e; color:white; padding:18px 20px; display:flex; align-items:center; gap:16px; }
header img { width:70px; height:70px; object-fit:contain; background:white; border-radius:50%; padding:5px; }
header h1, header h2 { font-size:24px; line-height:1.2; }
header p { font-size:14px; opacity:0.85; }
nav { background:white; padding:14px 20px; display:flex; gap:24px; box-shadow:0 2px 8px rgba(0,0,0,0.08); position:sticky; top:0; }
nav a { color:#0b4d2e; text-decoration:none; font-weight:700; font-size:15px; }
nav a:hover { color:#eab308; }
main, section { max-width:900px; margin:24px auto; padding:0 16px; }
h1 { font-size:28px; margin:18px 0 8px; color:#0b4d2e; }
p { margin-bottom:14px; color:#444; }
form { background:white; padding:28px; border-radius:12px; box-shadow:0 4px 20px rgba(0,0,0,0.08); max-width:520px; margin:20px auto; }
label { display:block; font-weight:600; margin:14px 0 6px; font-size:14px; }
input, select, textarea { width:100%; padding:12px; border:1.5px solid #ddd; border-radius:8px; font-size:15px; outline:none; }
input:focus { border-color:#0b4d2e; }
button, input[type="submit"] { width:100%; background:#0b4d2e; color:white; border:none; padding:13px; border-radius:8px; font-size:16px; font-weight:700; margin-top:18px; cursor:pointer; }
button:hover, input[type="submit"]:hover { background:#0e6b3f; }
a { color:#0b4d2e; }
footer { background:#0b4d2e; color:white; text-align:center; padding:18px; margin-top:40px; font-size:14px; }
img { max-width:100%; border-radius:10px; }
header p, header h2, header span { color:white !important; } header { align-items:center; } nav { justify-content:center; }
nav { justify-content:center; flex-wrap:wrap; gap:10px; padding:12px; }
nav a { background:#eef6f0; color:#0b4d2e; padding:10px 18px; border-radius:30px; border:1.5px solid #0b4d2e; font-size:15px; display:inline-block; }
nav a:hover { background:#0b4d2e; color:white; }
nav a:first-child { background:#0b4d2e; color:white; }
h1, h2, h3 { color:white !important; }
section h1, section h2 { color:#0b4d2e !important; }
main h1 { color:#0b4d2e !important; }
nav + *, header + * { padding-top:12px; }
h1, h2 { overflow:visible !important; line-height:1.3 !important; }
section:first-of-type h1, section:first-of-type h2 { color:#eab308 !important; }
main { padding-top:20px !important; }
